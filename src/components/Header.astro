---
import { SITE } from '../site.config';
import Paw from './Paw.astro';

const path = Astro.url.pathname;
const isAbout = path.startsWith('/about');
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Spooky Bear 2026, home">
      <span class="brand-paw"><Paw /></span>
      <span class="brand-text">Spooky Bear <span class="year">2026</span></span>
    </a>
    <nav aria-label="Site">
      <a href="/" aria-current={!isAbout ? 'page' : undefined}>Schedule</a>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
      <a href={`${SITE.repo}/issues/new/choose`} rel="noopener" target="_blank" data-feedback="bug">Feedback</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--bg);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding-block: 8px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--cream);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
    white-space: nowrap;
  }
  .brand-paw {
    width: 28px;
    height: 28px;
    color: var(--pumpkin);
    transform: rotate(-15deg);
  }
  .year {
    color: var(--pink);
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 12px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--cream);
    background: var(--raised);
  }
  nav a[aria-current='page'] {
    color: var(--cream);
    box-shadow: inset 0 -3px 0 var(--pink);
    border-radius: 0;
  }
  @media (max-width: 480px) {
    .brand-text {
      font-size: 1.1rem;
    }
    nav a {
      padding: 0 9px;
      font-size: 0.9rem;
    }
    nav a:last-child {
      display: none;
    }
  }
</style>
