---
import type { EventEntry, VenueEntry } from '../lib/events';
import { dayIdFor, priceKind, sortEvents } from '../lib/events';
import { DAYS, EVENT_TYPES } from '../site.config';
import EventRow from './EventRow.astro';
import EventDetail from './EventDetail.astro';
import FilterMenu from './FilterMenu.astro';
import Paw from './Paw.astro';

interface Props {
  events: EventEntry[];
  venues: VenueEntry[];
  /** Slug of the event whose detail should be open on first paint (shared links). */
  openSlug?: string;
}

const { events, venues, openSlug } = Astro.props;
const venueById = new Map(venues.map((v) => [v.id, v]));
const sorted = sortEvents(events);
const byDay = DAYS.map((d) => ({ ...d, events: sorted.filter((e) => e.data.date === d.date) })).filter(
  (d) => d.events.length > 0,
);
const count = (fn: (e: EventEntry) => boolean) => events.filter(fn).length;
const areaOptions = (['West End', 'Center', 'East End'] as const)
  .map((a) => ({ value: `area:${a}`, label: a, count: count((e) => venueById.get(e.data.venue.id)?.data.area === a) }))
  .filter((o) => o.count > 0);
const venueOptions = venues
  .map((v) => ({ value: v.id, label: v.data.shortName ?? v.data.name, count: count((e) => e.data.venue.id === v.id) }))
  .filter((o) => o.count > 0)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const typeOptions = Object.entries(EVENT_TYPES)
  .map(([value, label]) => ({ value, label, count: count((e) => e.data.type === value) }))
  .filter((o) => o.count > 0)
  .sort((a, b) => b.count - a.count);
const priceOptions = [
  { value: 'free', label: 'Free', count: count((e) => priceKind(e) === 'free') },
  { value: 'paid', label: 'Ticketed or cover', count: count((e) => priceKind(e) === 'paid') },
  { value: 'unknown', label: 'Price not confirmed', count: count((e) => priceKind(e) === 'unknown') },
].filter((o) => o.count > 0);
const openEvent = openSlug ? sorted.find((e) => e.id === openSlug) : undefined;
const initialDay = openEvent ? dayIdFor(openEvent.data.date) : undefined;
---

<section class="schedule" data-schedule data-initial-day={initialDay}>
  <div class="controls">
    <div class="wrap">
      <div class="tabs" role="tablist" aria-label="Day">
        {
          byDay.map((d) => (
            <button class="tab" role="tab" type="button" data-day-tab={d.id} aria-selected="false">
              <span class="tab-short">{d.short}</span>
              <span class="tab-date">{Number(d.date.slice(-2))}</span>
            </button>
          ))
        }
        <button class="tab" role="tab" type="button" data-day-tab="all" aria-selected="false">
          <span class="tab-short">All</span>
          <span class="tab-date">days</span>
        </button>
      </div>

      <div class="filters" data-filters>
        <button class="chip chip-icon" type="button" data-search-toggle aria-expanded="false" aria-controls="search-bar" aria-label="Search events">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        </button>
        <button class="den-toggle" type="button" data-den-toggle aria-pressed="false" aria-controls="den">
          <span class="icon"><Paw /></span>
          <span>My favs</span>
          <span class="count" data-den-count>0</span>
        </button>
        <FilterMenu id="venue" label="Location" groups={[{ label: 'Area', options: areaOptions }, { label: 'Venue', options: venueOptions }]} />
        <FilterMenu id="type" label="Type" groups={[{ options: typeOptions }]} />
        <FilterMenu id="price" label="Price" groups={[{ options: priceOptions }]} />
        <FilterMenu id="time" label="Time" groups={[]}>
          <div class="fm-time" slot="before">
            <div class="fm-presets">
              <button type="button" class="preset" data-time-preset="12:00|17:00">Afternoon</button>
              <button type="button" class="preset" data-time-preset="17:00|21:00">Evening</button>
              <button type="button" class="preset" data-time-preset="21:00|02:00">Late night</button>
            </div>
            <div class="fm-range">
              <label><span>From</span><input type="time" name="from" step="900" data-time-from /></label>
              <label><span>To</span><input type="time" name="to" step="900" data-time-to /></label>
            </div>
            <p class="fm-hint">Shows anything happening at some point between those times on the selected day.</p>
          </div>
        </FilterMenu>
        <button class="clear" type="button" data-clear hidden>Clear all</button>
      </div>

      <div class="search-bar" id="search-bar" hidden data-search-bar>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <input type="search" data-search-input placeholder="Search events, venues, performers…" autocomplete="off" autocorrect="off" spellcheck="false" aria-label="Search events" enterkeyhint="search" />
        <button type="button" class="search-cancel" data-search-close>Cancel</button>
      </div>
      <p class="search-note" data-search-note hidden>Searching across every day.</p>
    </div>
    <div class="fm-backdrop" data-menu-backdrop hidden></div>
  </div>

  <div class="wrap">
    <section class="den" id="den" data-den hidden aria-labelledby="den-title">
      <div class="den-head">
        <h2 id="den-title" class="den-title"><span class="icon"><Paw /></span> My favs</h2>
        <p class="den-sub">Saved on this device only. Nothing leaves your browser.</p>
      </div>
      <div data-den-list></div>
      <p class="den-empty" data-den-empty>Nothing saved yet. Tap the paw on anything that looks fun and it’ll show up here.</p>
    </section>

    <div class="days" data-days>
      {
        byDay.map((d) => (
          <section class="day" data-day-group={d.id} aria-labelledby={`day-${d.id}`}>
            <header class="day-head">
              <h2 id={`day-${d.id}`} class="day-title">
                {d.label}
                <span class="day-nick">{d.nick}</span>
              </h2>
              <span class="day-count" data-day-count>
                {d.events.length} {d.events.length === 1 ? 'event' : 'events'}
              </span>
            </header>
            <ol class="rows">
              {d.events.map((e) => {
                const venue = venueById.get(e.data.venue.id);
                if (!venue) throw new Error(`Event ${e.id} references unknown venue "${e.data.venue.id}"`);
                return <EventRow event={e} venue={venue} />;
              })}
            </ol>
            <p class="day-empty" data-day-empty hidden>
              Nothing matches these filters on {d.label}.
            </p>
          </section>
        ))
      }
      <p class="empty" data-empty hidden>
        No events match. <button type="button" class="link" data-clear>Clear the filters</button> to see everything.
      </p>
    </div>
  </div>

  <dialog class="dialog" id="event-dialog" aria-labelledby="dialog-title" data-dialog open={openEvent ? true : undefined}>
    <div class="dialog-card">
      <form method="dialog" class="dialog-bar">
        <button class="dialog-close" type="submit" aria-label="Close" data-close>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </form>
      <div class="dialog-body" data-dialog-body>
        {openEvent && <EventDetail event={openEvent} venue={venueById.get(openEvent.data.venue.id)!} />}
      </div>
    </div>
  </dialog>
</section>

<script src="../scripts/schedule.ts"></script>

<style>
  .controls {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 8px 0 10px;
  }
  .tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    background: var(--surface);
    padding: 4px;
    border-radius: 14px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    border-radius: 10px;
    color: var(--muted);
    line-height: 1.1;
    transition: background-color 0.15s, color 0.15s;
  }
  .tab-short {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .tab-date {
    font-size: 0.75rem;
    color: var(--faint);
  }
  .tab:hover {
    background: var(--raised);
    color: var(--cream);
  }
  .tab[aria-selected='true'] {
    background: var(--pink);
    color: #2a0516;
  }
  .tab[aria-selected='true'] .tab-date {
    color: #2a0516;
    opacity: 0.8;
  }
  .tabs.is-muted .tab[aria-selected='true'] {
    background: var(--plum-700);
    color: var(--cream);
  }
  .filters {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    -webkit-overflow-scrolling: touch;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }
  .filters::after {
    content: '';
    flex: none;
    width: 24px;
  }
  .filters.has-open {
    overflow: visible;
  }
  .chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 40px;
    min-height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--raised);
    color: var(--cream);
  }
  .chip-icon:hover,
  .chip-icon[aria-expanded='true'] {
    border-color: var(--pink);
    color: var(--pink);
  }
  .den-toggle,
  .clear {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--raised);
    color: var(--cream);
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .den-toggle .icon {
    width: 16px;
    height: 16px;
    color: var(--paw);
  }
  .den-toggle .count {
    background: var(--plum-700);
    color: var(--cream);
    border-radius: 999px;
    padding: 0 7px;
    font-size: 0.8rem;
    min-width: 20px;
    text-align: center;
  }
  .den-toggle[aria-pressed='true'] {
    background: var(--paw);
    border-color: var(--paw);
    color: #2a1200;
  }
  .den-toggle[aria-pressed='true'] .icon {
    color: #2a1200;
  }
  .den-toggle[aria-pressed='true'] .count {
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
  }
  .clear {
    color: var(--muted);
    background: transparent;
  }
  .icon {
    display: inline-block;
    width: 22px;
    height: 22px;
  }

  /* Time panel (rendered inside FilterMenu's slot) ------------------------ */
  .fm-time {
    padding: 4px 8px 8px;
  }
  .fm-presets {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .preset {
    min-height: 36px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--plum-900);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--cream);
  }
  .preset.is-on {
    background: var(--pink);
    border-color: var(--pink);
    color: #2a0516;
  }
  .fm-range {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .fm-range label span {
    display: block;
    font-size: 0.8rem;
    color: var(--faint);
    margin-bottom: 4px;
  }
  .fm-range input {
    width: 100%;
    font: inherit;
    color: var(--cream);
    background: var(--plum-900);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    min-height: var(--tap);
    color-scheme: dark;
  }
  .fm-hint {
    margin: 10px 0 0;
    color: var(--faint);
    font-size: 0.8rem;
  }
  .fm-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(8, 2, 14, 0.6);
  }
  @media (min-width: 720px) {
    .fm-backdrop {
      background: transparent;
    }
  }

  /* Search ------------------------------------------------------------- */
  .search-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 0 6px 0 12px;
    border: 1px solid var(--pink);
    border-radius: 999px;
    background: var(--raised);
    color: var(--faint);
  }
  .search-bar input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--cream);
    background: transparent;
    border: 0;
    min-height: var(--tap);
    outline: none;
  }
  .search-bar input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .search-cancel {
    flex: none;
    color: var(--pink);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0 10px;
    min-height: 38px;
  }
  .search-note {
    margin: 6px 0 0;
    color: var(--faint);
    font-size: 0.85rem;
  }

  /* Den ------------------------------------------------------------------ */
  .den {
    margin: 20px 0 8px;
    padding: 14px 14px 6px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 122, 26, 0.12), rgba(255, 122, 26, 0.03));
    border: 1px solid rgba(255, 122, 26, 0.35);
  }
  .den-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-bottom: 4px;
  }
  .den-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.35rem;
    color: var(--pumpkin);
  }
  .den-title .icon {
    transform: rotate(-15deg);
  }
  .den-sub,
  .den-empty {
    color: var(--faint);
    font-size: 0.9rem;
    margin: 0 0 8px;
  }
  .den-empty {
    padding: 8px 0 10px;
  }

  .den:has([data-den-list] > *) .den-empty {
    display: none;
  }

  /* Days --------------------------------------------------------------- */
  .day {
    margin-top: 22px;
  }
  .day-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .day-title {
    font-size: 1.5rem;
  }
  .day-nick {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--pink);
    margin-top: 2px;
  }
  .day-count {
    color: var(--faint);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .rows {
    list-style: none;
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 4px 10px;
  }
  .rows:empty {
    display: none;
  }
  .day-empty,
  .empty {
    color: var(--faint);
    padding: 16px 4px;
    margin: 0;
  }
  .link {
    color: var(--pink);
    text-decoration: underline;
  }

  /* Dialog ------------------------------------------------------------- */
  .dialog {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    background: transparent;
    color: var(--text);
    overflow: hidden;
  }
  .dialog::backdrop {
    background: rgba(8, 2, 14, 0.7);
    backdrop-filter: blur(4px);
  }
  .dialog[open] {
    display: grid;
    align-items: end;
    justify-items: center;
    position: fixed;
    inset: 0;
  }
  .dialog-card {
    position: relative;
    width: 100%;
    max-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--raised);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow);
    animation: rise 0.28s var(--ease);
    padding-bottom: env(safe-area-inset-bottom);
  }
  @keyframes rise {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }
  .dialog-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    height: 0;
    margin: 0;
  }
  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(21, 8, 31, 0.8);
    color: var(--cream);
    backdrop-filter: blur(6px);
  }
  .dialog-close:hover {
    background: var(--pink);
    color: #2a0516;
  }
  @media (min-width: 720px) {
    .dialog[open] {
      align-items: center;
      padding: 24px;
    }
    .dialog-card {
      max-width: 720px;
      max-height: calc(100dvh - 48px);
      border-radius: var(--radius-lg);
    }
  }
  .dialog[open]:not(:modal) {
    background: rgba(8, 2, 14, 0.7);
  }
</style>
