---
import type { EventEntry, VenueEntry } from '../lib/events';
import { dayIdFor, sortEvents } from '../lib/events';
import { DAYS, EVENT_TYPES } from '../site.config';
import EventRow from './EventRow.astro';
import EventDetail from './EventDetail.astro';
import Paw from './Paw.astro';

interface Props {
  events: EventEntry[];
  venues: VenueEntry[];
  /** Slug of the event whose detail should be open on first paint (shared links). */
  openSlug?: string;
}

const { events, venues, openSlug } = Astro.props;
const venueById = new Map(venues.map((v) => [v.id, v]));
const sorted = sortEvents(events);
const byDay = DAYS.map((d) => ({ ...d, events: sorted.filter((e) => e.data.date === d.date) })).filter(
  (d) => d.events.length > 0,
);
const usedVenues = venues
  .filter((v) => events.some((e) => e.data.venue.id === v.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const usedTypes = Object.entries(EVENT_TYPES).filter(([k]) => events.some((e) => e.data.type === k));
const openEvent = openSlug ? sorted.find((e) => e.id === openSlug) : undefined;
const initialDay = openEvent ? dayIdFor(openEvent.data.date) : undefined;
---

<section class="schedule" data-schedule data-initial-day={initialDay}>
  <div class="controls">
    <div class="wrap">
      <div class="tabs" role="tablist" aria-label="Day">
        {
          byDay.map((d) => (
            <button class="tab" role="tab" type="button" data-day-tab={d.id} aria-selected="false">
              <span class="tab-short">{d.short}</span>
              <span class="tab-date">{Number(d.date.slice(-2))}</span>
            </button>
          ))
        }
        <button class="tab" role="tab" type="button" data-day-tab="all" aria-selected="false">
          <span class="tab-short">All</span>
          <span class="tab-date">days</span>
        </button>
      </div>
      <div class="filters">
        <label class="select">
          <span class="visually-hidden">Location</span>
          <select data-filter="venue" aria-label="Filter by location">
            <option value="">Anywhere in Ptown</option>
            <optgroup label="By area">
              <option value="area:West End">West End</option>
              <option value="area:Center">Center</option>
              <option value="area:East End">East End</option>
            </optgroup>
            <optgroup label="By venue">
              {usedVenues.map((v) => <option value={v.id}>{v.data.shortName ?? v.data.name}</option>)}
            </optgroup>
          </select>
        </label>
        <label class="select">
          <span class="visually-hidden">Event type</span>
          <select data-filter="type" aria-label="Filter by event type">
            <option value="">Any kind of event</option>
            {usedTypes.map(([k, label]) => <option value={k}>{label}</option>)}
          </select>
        </label>
        <label class="select">
          <span class="visually-hidden">Price</span>
          <select data-filter="price" aria-label="Filter by price">
            <option value="">Free or ticketed</option>
            <option value="free">Free only</option>
            <option value="paid">Ticketed only</option>
          </select>
        </label>
        <button class="den-toggle" type="button" data-den-toggle aria-pressed="false" aria-controls="den">
          <span class="icon"><Paw /></span>
          <span>My den</span>
          <span class="count" data-den-count>0</span>
        </button>
        <button class="clear" type="button" data-clear hidden>Clear filters</button>
      </div>
    </div>
  </div>

  <div class="wrap">
    <section class="den" id="den" data-den hidden aria-labelledby="den-title">
      <div class="den-head">
        <h2 id="den-title" class="den-title"><span class="icon"><Paw /></span> My den</h2>
        <p class="den-sub">Saved on this device only. Nothing leaves your browser.</p>
      </div>
      <ol class="rows" data-den-list></ol>
      <p class="den-empty" data-den-empty>
        Nothing saved yet. Tap the paw on anything that looks fun and it’ll show up here.
      </p>
    </section>

    <div class="days" data-days>
      {
        byDay.map((d) => (
          <section class="day" data-day-group={d.id} aria-labelledby={`day-${d.id}`}>
            <header class="day-head">
              <h2 id={`day-${d.id}`} class="day-title">
                {d.label}
                <span class="day-nick">{d.nick}</span>
              </h2>
              <span class="day-count" data-day-count>
                {d.events.length} {d.events.length === 1 ? 'event' : 'events'}
              </span>
            </header>
            <ol class="rows">
              {d.events.map((e) => {
                const venue = venueById.get(e.data.venue.id);
                if (!venue) throw new Error(`Event ${e.id} references unknown venue "${e.data.venue.id}"`);
                return <EventRow event={e} venue={venue} />;
              })}
            </ol>
            <p class="day-empty" data-day-empty hidden>
              Nothing matches these filters on {d.label}.
            </p>
          </section>
        ))
      }
      <p class="empty" data-empty hidden>
        No events match. <button type="button" class="link" data-clear>Clear the filters</button> to see everything.
      </p>
    </div>
  </div>

  {
    sorted.map((e) => {
      const venue = venueById.get(e.data.venue.id)!;
      return (
        <template data-detail={e.id}>
          <EventDetail event={e} venue={venue} />
        </template>
      );
    })
  }

  <dialog class="dialog" id="event-dialog" aria-labelledby="dialog-title" data-dialog open={openEvent ? true : undefined}>
    <div class="dialog-card">
      <form method="dialog" class="dialog-bar">
        <button class="dialog-close" type="submit" aria-label="Close" data-close>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </form>
      <div class="dialog-body" data-dialog-body>
        {openEvent && <EventDetail event={openEvent} venue={venueById.get(openEvent.data.venue.id)!} />}
      </div>
    </div>
  </dialog>
</section>

<script src="../scripts/schedule.ts"></script>

<style>
  .controls {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding: 8px 0 10px;
  }
  .tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 4px;
    background: var(--surface);
    padding: 4px;
    border-radius: 14px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    border-radius: 10px;
    color: var(--muted);
    line-height: 1.1;
    transition: background-color 0.15s, color 0.15s;
  }
  .tab-short {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .tab-date {
    font-size: 0.75rem;
    color: var(--faint);
  }
  .tab:hover {
    background: var(--raised);
    color: var(--cream);
  }
  .tab[aria-selected='true'] {
    background: var(--pink);
    color: #2a0516;
  }
  .tab[aria-selected='true'] .tab-date {
    color: #2a0516;
    opacity: 0.8;
  }
  .filters {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    -webkit-overflow-scrolling: touch;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }
  .select {
    position: relative;
    flex: none;
  }
  .select select {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cream);
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    min-height: 38px;
    padding: 6px 30px 6px 14px;
    max-width: 52vw;
    text-overflow: ellipsis;
  }
  .select::after {
    content: '';
    position: absolute;
    right: 13px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 2px solid var(--faint);
    border-bottom: 2px solid var(--faint);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .select:has(select:not([value=''])):has(option:checked:not([value=''])) select {
    border-color: var(--pink);
    color: var(--pink);
  }
  .den-toggle,
  .clear {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--raised);
    color: var(--cream);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .den-toggle .icon {
    width: 16px;
    height: 16px;
    color: var(--paw);
  }
  .den-toggle .count {
    background: var(--plum-700);
    color: var(--cream);
    border-radius: 999px;
    padding: 0 7px;
    font-size: 0.8rem;
    min-width: 20px;
    text-align: center;
  }
  .den-toggle[aria-pressed='true'] {
    background: var(--paw);
    border-color: var(--paw);
    color: #2a1200;
  }
  .den-toggle[aria-pressed='true'] .icon {
    color: #2a1200;
  }
  .den-toggle[aria-pressed='true'] .count {
    background: rgba(0, 0, 0, 0.25);
    color: #fff;
  }
  .clear {
    color: var(--muted);
    background: transparent;
  }
  .icon {
    display: inline-block;
    width: 22px;
    height: 22px;
  }

  .den {
    margin: 20px 0 8px;
    padding: 14px 14px 6px;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 122, 26, 0.12), rgba(255, 122, 26, 0.03));
    border: 1px solid rgba(255, 122, 26, 0.35);
  }
  .den-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-bottom: 4px;
  }
  .den-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.35rem;
    color: var(--pumpkin);
  }
  .den-title .icon {
    transform: rotate(-15deg);
  }
  .den-sub,
  .den-empty {
    color: var(--faint);
    font-size: 0.9rem;
    margin: 0 0 8px;
  }
  .den-empty {
    padding: 8px 0 10px;
  }
  .den:not(:has([data-den-list] > *)) .den-empty {
    display: block;
  }
  .den:has([data-den-list] > *) .den-empty {
    display: none;
  }

  .day {
    margin-top: 22px;
  }
  .day-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .day-title {
    font-size: 1.5rem;
  }
  .day-nick {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--pink);
    margin-top: 2px;
  }
  .day-count {
    color: var(--faint);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 4px 10px;
  }
  .rows:empty {
    display: none;
  }
  .day-empty,
  .empty {
    color: var(--faint);
    padding: 16px 4px;
    margin: 0;
  }
  .link {
    color: var(--pink);
    text-decoration: underline;
  }

  /* Dialog ------------------------------------------------------------- */
  .dialog {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    background: transparent;
    color: var(--text);
    overflow: hidden;
  }
  .dialog::backdrop {
    background: rgba(8, 2, 14, 0.7);
    backdrop-filter: blur(4px);
  }
  .dialog[open] {
    display: grid;
    align-items: end;
    justify-items: center;
    position: fixed;
    inset: 0;
  }
  .dialog-card {
    position: relative;
    width: 100%;
    max-height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--raised);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow);
    animation: rise 0.28s var(--ease);
    padding-bottom: env(safe-area-inset-bottom);
  }
  @keyframes rise {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
  }
  .dialog-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    height: 0;
    margin: 0;
  }
  .dialog-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(21, 8, 31, 0.8);
    color: var(--cream);
    backdrop-filter: blur(6px);
  }
  .dialog-close:hover {
    background: var(--pink);
    color: #2a0516;
  }
  @media (min-width: 720px) {
    .dialog[open] {
      align-items: center;
      padding: 24px;
    }
    .dialog-card {
      max-width: 720px;
      max-height: calc(100dvh - 48px);
      border-radius: var(--radius-lg);
    }
  }
  /* No-JS fallback: the dialog is rendered open but non-modal on /event pages. */
  .dialog[open]:not(:modal) {
    background: rgba(8, 2, 14, 0.7);
  }
</style>
