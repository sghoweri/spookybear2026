---
import '../styles/global.css';
import { SITE } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeedbackDialog from '../components/FeedbackDialog.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL for the social preview image. */
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.tagline,
  image = '/og.png',
  canonical,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: Provincetown Halloween weekend schedule`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const ga = import.meta.env.PROD ? SITE.gaId : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#15081f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Spooky Bear" />
    <meta name="application-name" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="alternate" type="application/json" title="All events (JSON)" href="/events.json" />
    <link rel="alternate" type="text/calendar" title="All events (iCalendar)" href="/events.ics" />
    <link rel="author" href="/about" />
    <link rel="privacy-policy" href="/privacy" />
    <link rel="preload" href="/fonts/alfa-slab-one.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />

    {
      ga && (
        <>
          <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${ga}`} />
          <script
            type="text/partytown"
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${ga}',{anonymize_ip:true});`}
          />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to schedule</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FeedbackDialog />
    <script src="../scripts/feedback.ts"></script>
    <script src="../scripts/monitoring.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    background: var(--candle);
    color: #2a1a00;
    padding: 10px 14px;
    border-radius: 8px;
    font-weight: 700;
  }
  .skip:focus {
    top: 12px;
  }
  main {
    padding-bottom: 48px;
  }
</style>
